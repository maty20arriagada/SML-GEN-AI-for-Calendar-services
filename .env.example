# Copia a .env y completa. No commitear el .env real.
# GitHub PAT para clonar repo privado en Colab (scope repo). Solo en Secrets de Colab, no en .env real.
GITHUB_PAT=ghp_xxxxxxxxxxxxxxxx

# Hugging Face: crea token en https://huggingface.co/settings/tokens
# Permiso necesario: inference.serverless.write
HF_TOKEN=hf_xxxxxxxxxxxxxxxx

# Google Cloud OAuth (Desktop app):
# Consola: https://console.cloud.google.com/ -> APIs: Google Calendar API -> Credenciales OAuth Client ID
GOOGLE_CLIENT_ID=tu-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=tu-client-secret
USER_GOOGLE_EMAIL=tu-correo@gmail.com
